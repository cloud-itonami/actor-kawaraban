;; kawaraban 瓦版 — live mirror archive（自動生成 / 手編集しない）
;; `kawaraban.store/append-articles!` が追記マージする。1行1記事、
;; :news.article/id で dedupe、as-of 降順。`schema/news.edn` でそのまま
;; transact でき、`clojure -M:query` が読む。
;;
;; G4 — headline + canonical url + 280字以内の excerpt + outlet のみ。
;; 本文は決して含まれない（含む record は ingest が refuse する）。
;; G5 — :news.article/sourcing :verified = その媒体自身の feed から実際に
;; 取得した記事。data/seed.edn の :representative（例示）とは別物。

[#:news.article{:outlet "outlet.unicef", :lang ["en"], :kind :mirror, :headline "Humanitarian crisis for children deepens after one month of war in the Middle East", :as-of 1774917543, :url "https://www.unicef.org/press-releases/humanitarian-crisis-children-deepens-after-one-month-war-middle-east", :section "sec.international", :excerpt "Beyond the staggering casualty toll, delays and disruptions in supply operations put children at risk across the globe", :id "art.outlet.unicef.1774917543", :sourcing :verified}]
