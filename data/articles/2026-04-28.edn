;; kawaraban 瓦版 — live mirror archive（自動生成 / 手編集しない）
;; `kawaraban.store/append-articles!` が追記マージする。1行1記事、
;; :news.article/id で dedupe、as-of 降順。`schema/news.edn` でそのまま
;; transact でき、`clojure -M:query` が読む。
;;
;; G4 — headline + canonical url + 280字以内の excerpt + outlet のみ。
;; 本文は決して含まれない（含む record は ingest が refuse する）。
;; G5 — :news.article/sourcing :verified = その媒体自身の feed から実際に
;; 取得した記事。data/seed.edn の :representative（例示）とは別物。

[#:news.article{:outlet "outlet.unicef", :lang ["en"], :kind :mirror, :headline "Hunger intensifies in South Sudan as 7.8 million people face high acute food insecurity and 2.2 million children suffer acute malnutrition", :as-of 1777382741, :url "https://www.unicef.org/press-releases/hunger-intensifies-south-sudan-78-million-people-face-high-acute-food-insecurity-0", :section "sec.international", :excerpt "Conflict and displacement drive worsening crisis, with risk of famine in hardest-hit areas; nearly 700,000 children in danger of severe and deadly malnutrition", :id "art.outlet.unicef.1777382741", :sourcing :verified}
