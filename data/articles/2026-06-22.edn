;; kawaraban 瓦版 — live mirror archive（自動生成 / 手編集しない）
;; `kawaraban.store/append-articles!` が追記マージする。1行1記事、
;; :news.article/id で dedupe、as-of 降順。`schema/news.edn` でそのまま
;; transact でき、`clojure -M:query` が読む。
;;
;; G4 — headline + canonical url + 280字以内の excerpt + outlet のみ。
;; 本文は決して含まれない（含む record は ingest が refuse する）。
;; G5 — :news.article/sourcing :verified = その媒体自身の feed から実際に
;; 取得した記事。data/seed.edn の :representative（例示）とは別物。

[#:news.article{:outlet "outlet.unicef", :lang ["en"], :kind :mirror, :headline "As Ebola cases hit 1,000, almost 3 million children and adolescents face rising risks in eastern DR Congo – UNICEF", :as-of 1782143059, :url "https://www.unicef.org/press-releases/ebola-cases-hit-1000-almost-3-million-children-and-adolescents-face-rising-risks", :section "sec.international", :excerpt "Ebola has left over 130 children orphaned in Ituri, driving urgent need for protection and care", :id "art.outlet.unicef.1782143059", :sourcing :verified}
