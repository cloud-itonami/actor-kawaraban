<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- kawaraban 瓦版 — 6時間ごとの実収集（ADR-2607252600 / 2607253400）。

     G8 は 2026-07-26 に承認済み（BOOTSTRAP-ATTESTATION-live-ingest.md、Seat 1
     provisional）。この plist が KAWARABAN_ALLOW_LIVE_INGEST=1 を渡す。

     **KAWARABAN_WASM_PDS_ALLOWLIST は渡さない。** 未設定は kototama の url-allowed?
     では deny-all なので、pds.aozora.app への publish は HttpClient.send の前で
     拒否される。読むことと共有本番 PDS へ署名済みレコードを書くことは別の行為で、
     後者を有効にするならそれ自身の判断と記録が要る。

     KAWARABAN_WASM_MAX_ARTICLES_PER_OUTLET=0 は publish 対象を空にする。アーカイブは
     gate を通った全件から書かれ（archive-records! はこの上限に縛られない）ので、
     収集は完全・外向き処理はゼロ。2026-07-10 の「3記事/outlet」で CPU 予算を超過し
     共有グラフの read latency が 4s→50s になった実測（ADR-2607110200 addendum 2）が
     あるため、publish を戻すときは同じ轍を踏まないこと。

     専用 clone ~/.kawaraban/ingest-clone で動く。west 管理下の共有 checkout でも、
     週次 refresh 用 clone でもない — 無人ジョブが reset/clean する木を人や他ジョブと
     共有しない。scripts/ingest-cron.cljs が fetch/reset/収集/検証/commit/push を行う。

     インストール:
       cp scripts/launchd/com.etzhayyim.kawaraban.wasm-orchestrator.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.etzhayyim.kawaraban.wasm-orchestrator.plist
     ログ: ~/.kawaraban/logs/ingest.log
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.etzhayyim.kawaraban.wasm-orchestrator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>/Users/junkawasaki/.kawaraban/ingest-clone/scripts/ingest-cron.cljs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/junkawasaki/.kawaraban/ingest-clone</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/junkawasaki</string>
    <key>KAWARABAN_ALLOW_LIVE_INGEST</key><string>1</string>
    <key>KAWARABAN_WASM_MAX_OUTLETS</key><string>200</string>
    <key>KAWARABAN_WASM_MAX_ARTICLES_PER_OUTLET</key><string>0</string>
  </dict>
  <key>StartInterval</key><integer>21600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/junkawasaki/.kawaraban/logs/ingest.log</string>
  <key>StandardErrorPath</key><string>/Users/junkawasaki/.kawaraban/logs/ingest.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
